# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
build/
dist/

# Virtual environments
.venv/
venv/

# Generated warehouse (rebuilt from data/raw via scripts/init_database.py)
data/warehouse/*.duckdb

# Generated star schema (~17MB). Deterministically rebuilt from the committed
# source CSV by scripts/build_star_schema.py under a fixed seed, so committing it
# would be storing a pure function of two files already in the repo. init_database
# raises a WarehouseError naming the generator if it is missing.
data/raw/star/
data/semantic/embedding_cache.json

# Nightly eval logs: the artefact worth keeping is the run in evals/results/,
# not the terminal output that produced it.
evals/logs/

# The airline domain's CSVs, generated by scripts/build_airline_domain.py under a
# fixed seed -- ignored for the same reason data/raw/star/ is: committing them
# would store a pure function of a script already in the repo. init_database
# raises a WarehouseError naming the generator if they are missing.
data/raw/airline/

# Per-domain caches. Both are derived state that is rebuilt on demand, and the
# semantic cache in particular is a local query log -- it records the questions
# whoever ran this checkout happened to ask.
data/warehouse/*_embedding_cache.json
data/warehouse/*_semantic_cache.json

# Governance audit logs are runtime records of this checkout's own queries, not
# artefacts of the project. Committing one would put a developer's questions --
# and the principal each ran as -- into the repo, and the hash chain would
# interleave every machine that ever ran it into one broken sequence.
data/audit/

# Local command scratchpad -- a working note, not project documentation.
Run_commands.txt
